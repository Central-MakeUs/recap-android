<?xml version="1.0" encoding="utf-8"?>
<!--
   Cloud backup and device-transfer rules for API 31+.
   Sensitive local data is excluded; server is source of truth after restore.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="recap/" />
        <exclude domain="file" path="datastore/user_preferences.preferences_pb" />
        <exclude domain="database" path="recap.db" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="recap/" />
        <exclude domain="file" path="datastore/user_preferences.preferences_pb" />
        <exclude domain="database" path="recap.db" />
    </device-transfer>
</data-extraction-rules>
