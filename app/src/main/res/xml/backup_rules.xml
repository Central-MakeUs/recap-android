<?xml version="1.0" encoding="utf-8"?>
<!--
   Auto Backup rules for API 23–30 (fullBackupContent).
   API 31+ uses data_extraction_rules.xml instead.
   Server is source of truth for screenshots/analysis; restore expects re-login + re-sync.
-->
<full-backup-content>
    <!-- App-private screenshot images and thumbnails under filesDir/recap/ -->
    <exclude domain="file" path="recap/" />
    <!-- Session tokens and user prefs (same DataStore file) -->
    <exclude domain="file" path="datastore/user_preferences.preferences_pb" />
    <!-- Local account owner marker; must not follow the app to another device -->
    <exclude domain="file" path="datastore/account_owner.preferences_pb" />
    <!-- Room DB; sidecars (-journal/-shm/-wal) follow the basename -->
    <exclude domain="database" path="recap.db" />
</full-backup-content>
